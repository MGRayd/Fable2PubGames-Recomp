+bool InvokeBind(std::string_view name) {
+  std::function<void()> callback;
+  {
+    std::lock_guard lock(g_binds_mutex);
+    for (auto& entry : g_binds) {
+      if (entry.name == name && entry.callback) {
+        callback = entry.callback;
+        break;
+      }
+    }
+  }
+  if (!callback) {
+    return false;
+  }
+  callback();
+  return true;
+}
